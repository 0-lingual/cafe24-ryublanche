# Streamlit Cloud Secrets 설정 예시
# 실제 값으로 채운 후 파일명을 secrets.toml로 변경하거나
# Streamlit Cloud → App settings → Secrets 에 붙여넣으세요.
# (이 파일은 Git에 포함되어도 안전합니다 — 실제 값이 없으므로)

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY = "sk-ant-api03-..."

# ── 카페24 앱 인증 ──────────────────────────────────────────────────────────────
CAFE24_MALL_ID        = "your_mall_id"
CAFE24_CLIENT_ID      = "your_client_id"
CAFE24_CLIENT_SECRET  = "your_client_secret"
CAFE24_API_VERSION    = "2026-03-01"
CAFE24_REDIRECT_URI   = "https://your-tunnel-url"   # 초기 로그인 시에만 필요

# ── 카페24 OAuth 토큰 ───────────────────────────────────────────────────────────
# 초기 발급: 로컬에서 'uv run main.py login' 실행 후 .token.json에서 복사
# 이후: GitHub Actions가 매주 자동 갱신 → 수동 개입 불필요
CAFE24_ACCESS_TOKEN      = "..."
CAFE24_REFRESH_TOKEN     = "..."
CAFE24_TOKEN_EXPIRES_AT  = "2026-04-25T12:00:00"   # ISO 형식, 없어도 됨

# ── 토큰 자동화 (GitHub Gist) ────────────────────────────────────────────────
# 1. github.com/settings/tokens → New token → gist 권한만 선택
# 2. gist.github.com → New Gist → Secret (비공개)
#    파일명: cafe24_tokens.json  내용: {}
# 3. Gist URL에서 ID 복사 (예: https://gist.github.com/user/[GIST_ID])
# 4. GitHub Actions secrets에도 동일하게 추가: GH_TOKEN, GIST_ID
GITHUB_TOKEN   = "ghp_..."   # PAT with gist scope
GIST_ID = "..."       # Private Gist ID
