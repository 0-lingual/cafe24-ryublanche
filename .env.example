# Cafe24 API 인증 정보
# .env 파일을 새로 만들고 아래 값들을 채워주세요.
# 카페24 개발자센터(https://developers.cafe24.com)에서 앱 등록 후 발급받을 수 있습니다.

CAFE24_MALL_ID=ryublanche
CAFE24_CLIENT_ID=your_client_id_here
CAFE24_CLIENT_SECRET=your_client_secret_here
CAFE24_REDIRECT_URI=http://localhost:8080

# 카페24 API 버전 (현재 최신: 2024-09-01)
CAFE24_API_VERSION=2024-09-01

# Anthropic API 키 (Claude Vision 이미지 분석에 필요)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
